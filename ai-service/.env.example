APP_NAME=KnowledgeAI Engine
APP_ENV=development
APP_VERSION=1.0.0

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/knowledge_ai

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=
LLM_MAX_RETRIES=3
LLM_BASE_DELAY=1.0
LLM_MAX_DELAY=10.0
LLM_TIMEOUT=30.0
LLM_JITTER=true

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.45
RAG_MAX_CONTEXT_TOKENS=6000